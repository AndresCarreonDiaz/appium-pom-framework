{
  "name": "appium-pom-framework",
  "description": "Cross-platform mobile test automation with Appium, WebdriverIO and TypeScript using the Page Object Model",
  "scripts": {
    "apps": "./scripts/download-apps.sh",
    "test:android": "wdio run config/wdio.android.conf.ts",
    "test:ios": "wdio run config/wdio.ios.conf.ts",
    "typecheck": "tsc",
    "lint": "eslint ."
  },
  "author": "Andres Carreon",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.2",
    "@wdio/appium-service": "^9.32.0",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/junit-reporter": "^9.32.0",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "appium": "^3.7.0",
    "appium-uiautomator2-driver": "^8.7.0",
    "appium-xcuitest-driver": "^12.13.1",
    "eslint": "^10.11.0",
    "eslint-plugin-wdio": "^9.31.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "private": true
